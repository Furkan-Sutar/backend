{
    "name": "skill-nova-backend",
    "version": "1.0.0",
    "private": true,
    "description": "Skill Nova production backend foundation",
    "main": "dist/server.js",
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "tsc -p tsconfig.json",
        "db:indexes": "node dist/scripts/create-indexes.js",
        "start": "node dist/server.js",
        "test": "vitest run",
        "test:e2e": "vitest run e2e/lifecycle.e2e.test.ts",
        "test:watch": "vitest"
    },
    "engines": {
        "node": ">=20.0.0"
    },
    "dependencies": {
        "bcryptjs": "^3.0.3",
        "cors": "^2.8.5",
        "dotenv": "^16.4.7",
        "express": "^5.1.0",
        "express-rate-limit": "^7.5.0",
        "google-auth-library": "^11.3.2",
        "helmet": "^8.1.0",
        "jsonwebtoken": "^9.0.3",
        "mongoose": "^8.12.1",
        "pino": "^9.6.0",
        "pino-http": "^10.4.0",
        "zod": "^3.24.2"
    },
    "devDependencies": {
        "@types/cors": "^2.8.17",
        "@types/express": "^5.0.1",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^22.13.10",
        "@types/supertest": "^6.0.2",
        "mongodb-memory-server": "^11.3.0",
        "pino-pretty": "^13.0.0",
        "supertest": "^7.1.0",
        "tsx": "^4.19.3",
        "typescript": "^5.8.2",
        "vitest": "^5.0.4"
    },
    "type": "module"
}
