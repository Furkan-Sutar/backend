NODE_ENV=development
PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/skill_nova
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
TRUST_PROXY=false
MONGO_MAX_POOL_SIZE=20
MONGO_MIN_POOL_SIZE=0
MONGO_SERVER_SELECTION_TIMEOUT_MS=10000
JSON_BODY_LIMIT=1mb
PRIVATE_DOCUMENT_STORAGE_PATH=./private-documents
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
LOG_LEVEL=info
APP_URL=http://localhost:3000
# Future authentication and integrations: replace placeholders before enabling those modules.
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_DURATION_MS=900000
# Refresh tokens are opaque random values stored as hashes; no signing secret is needed.
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
FILE_STORAGE_PROVIDER=local
FILE_STORAGE_BUCKET=replace-with-bucket-name
EMAIL_PROVIDER=replace-with-provider
SMS_PROVIDER=replace-with-provider



