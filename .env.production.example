NODE_ENV=production
PORT=3000
MONGO_URI=mongodb+srv://<production-user>:<password>@<production-cluster>/<database>?retryWrites=true&w=majority
CORS_ORIGINS=https://app.example.com
TRUST_PROXY=true
APP_URL=https://app.example.com
MONGO_MAX_POOL_SIZE=50
MONGO_MIN_POOL_SIZE=5
MONGO_SERVER_SELECTION_TIMEOUT_MS=10000
JSON_BODY_LIMIT=1mb
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
LOG_LEVEL=info
JWT_ACCESS_SECRET=replace-with-a-unique-random-secret-of-at-least-32-characters
GOOGLE_CLIENT_ID=81235979948-n1mlt9hoj5tf5f3umj3i6r0dt21hrj4s.apps.googleusercontent.com
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_DURATION_MS=900000
PRIVATE_DOCUMENT_STORAGE_PATH=/var/lib/skill-nova/private-documents
