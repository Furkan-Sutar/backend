{
    "compilerOptions":  {
                            "target":  "ES2022",
                            "module":  "NodeNext",
                            "moduleResolution":  "NodeNext",
                            "rootDir":  "src",
                            "outDir":  "dist",
                            "strict":  true,
                            "noImplicitOverride":  true,
                            "noUncheckedIndexedAccess":  true,
                            "exactOptionalPropertyTypes":  true,
                            "esModuleInterop":  true,
                            "forceConsistentCasingInFileNames":  true,
                            "skipLibCheck":  true,
                            "declaration":  true,
                            "sourceMap":  true,
                            "resolveJsonModule":  true,
                            "types":  [
                                          "node",
                                          "vitest/globals"
                                      ]
                        },
    "include":  [
                    "src/**/*.ts"
                ],
    "exclude":  [
                    "node_modules",
                    "dist",
                    "src/tests"
                ]
}
